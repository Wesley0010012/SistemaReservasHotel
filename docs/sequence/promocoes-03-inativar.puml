@startuml "Inativar promoção - Fluxo de Sucesso"
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 8
skinparam defaultFontName Arial
skinparam ArrowColor #1F2937
skinparam LifeLineBorderColor #64748B
skinparam LifeLineBackgroundColor #E2E8F0
skinparam actor {
  BackgroundColor #F8FAFC
  BorderColor #111827
}
skinparam participant {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
}
skinparam entity {
  BackgroundColor #F0FDF4
  BorderColor #16A34A
}
skinparam database {
  BackgroundColor #FFF7ED
  BorderColor #EA580C
}
title Inativar promoção - Fluxo de Sucesso

actor Usuario
participant "Interface Web" as UI
participant "PromocoesController" as Controller
participant "PromocoesFacade" as Facade
participant "DTO" as DTO
participant "Strategy" as Strategy
entity "Promocao" as Domain
entity "TypeormPromocaoEntity" as PersistEntity
database "TypeormPromocoesDao" as Dao

Usuario -> UI: solicita inativação
UI -> Controller: DELETE /promocoes/{id}
Controller -> Facade: deleteById(id)
Facade -> Strategy: FIND_BY_ID
Strategy -> Dao: findById(id)
Dao -> PersistEntity: consultar entidade TypeORM
PersistEntity --> Dao: entidade ativa
Dao --> Strategy: entidade de domínio
Facade -> Strategy: DELETE
Strategy -> Domain: inativar()
Domain -> Domain: active = false
Strategy -> Dao: update(entidade inativa)
Dao -> PersistEntity: mapear status inativo
Dao -> Dao: repository.save(entity)
Facade -> Strategy: ENTITY_TO_DTO
Strategy --> Facade: OutputDto
Facade --> Controller: OutputDto
Controller --> UI: 200 OK
UI --> Usuario: exibe registro inativado
@enduml
