@startuml "Cadastrar política de cancelamento - Fluxo de Sucesso"
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 8
skinparam defaultFontName Arial
skinparam ArrowColor #1F2937
skinparam LifeLineBorderColor #64748B
skinparam LifeLineBackgroundColor #E2E8F0
skinparam actor {
  BackgroundColor #F8FAFC
  BorderColor #111827
}
skinparam participant {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
}
skinparam entity {
  BackgroundColor #F0FDF4
  BorderColor #16A34A
}
skinparam database {
  BackgroundColor #FFF7ED
  BorderColor #EA580C
}
title Cadastrar política de cancelamento - Fluxo de Sucesso

actor Usuario
participant "Interface Web" as UI
participant "PoliticasCancelamentoController" as Controller
participant "PoliticasCancelamentoFacade" as Facade
participant "DTO" as DTO
participant "Strategy" as Strategy
entity "PoliticaCancelamento" as Domain
entity "TypeormPoliticaCancelamentoEntity" as PersistEntity
database "TypeormPoliticasCancelamentoDao" as Dao

Usuario -> UI: preenche dados obrigatórios
UI -> Controller: POST /politicas - PoliticaCancelamentoAddInputDto / UpdateInputDto / SearchParameters
Controller -> Facade: add(dto)
Facade -> DTO: receber dados de entrada
Facade -> Strategy: ADD_INPUT_DTO_TO_ENTITY
Strategy -> Domain: construir entidade de domínio
Domain -> Domain: validar dados obrigatórios e regras
Facade -> Strategy: ADD
Strategy -> Dao: add(PoliticaCancelamento)
Dao -> PersistEntity: mapear domínio para entidade TypeORM
Dao -> Dao: repository.save(entity)
Dao --> Strategy: entidade persistida
Facade -> Strategy: ENTITY_TO_DTO
Strategy --> Facade: OutputDto
Facade --> Controller: OutputDto
Controller --> UI: 201 Created
UI --> Usuario: exibe registro cadastrado
@enduml
