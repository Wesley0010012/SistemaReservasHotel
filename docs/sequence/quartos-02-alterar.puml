@startuml "Alterar cadastro de quarto - Fluxo de Sucesso"
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 8
skinparam defaultFontName Arial
skinparam ArrowColor #1F2937
skinparam LifeLineBorderColor #64748B
skinparam LifeLineBackgroundColor #E2E8F0
skinparam actor {
  BackgroundColor #F8FAFC
  BorderColor #111827
}
skinparam participant {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
}
skinparam entity {
  BackgroundColor #F0FDF4
  BorderColor #16A34A
}
skinparam database {
  BackgroundColor #FFF7ED
  BorderColor #EA580C
}
title Alterar cadastro de quarto - Fluxo de Sucesso

actor Usuario
participant "Interface Web" as UI
participant "QuartosController" as Controller
participant "QuartosFacade" as Facade
participant "DTO" as DTO
participant "Strategy" as Strategy
entity "Quarto, TipoQuarto, StatusQuarto" as Domain
entity "TypeormQuartoEntity" as PersistEntity
database "TypeormQuartosDao" as Dao

Usuario -> UI: altera dados do registro
UI -> Controller: PUT /quartos/{id} - QuartoAddInputDto / QuartoUpdateInputDto / QuartoSearchParameters
Controller -> Facade: update(dto)
Facade -> Strategy: FIND_BY_ID
Strategy -> Dao: findById(id)
Dao -> PersistEntity: consultar entidade TypeORM
PersistEntity --> Dao: entidade encontrada
Dao --> Strategy: entidade de domínio atual
Facade -> Strategy: UPDATE_INPUT_DTO_TO_ENTITY
Strategy -> Domain: aplicar dados alterados
Domain -> Domain: validar regras de alteração
Facade -> Strategy: UPDATE
Strategy -> Dao: update(entidade)
Dao -> PersistEntity: mapear domínio atualizado
Dao -> Dao: repository.save(entity)
Facade -> Strategy: ENTITY_TO_DTO
Strategy --> Facade: OutputDto
Facade --> Controller: OutputDto
Controller --> UI: 200 OK
UI --> Usuario: exibe alteração concluída
@enduml
