@startuml "Consultar hóspedes - Fluxo de Sucesso"
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 8
skinparam defaultFontName Arial
skinparam ArrowColor #1F2937
skinparam LifeLineBorderColor #64748B
skinparam LifeLineBackgroundColor #E2E8F0
skinparam actor {
  BackgroundColor #F8FAFC
  BorderColor #111827
}
skinparam participant {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
}
skinparam entity {
  BackgroundColor #F0FDF4
  BorderColor #16A34A
}
skinparam database {
  BackgroundColor #FFF7ED
  BorderColor #EA580C
}
title Consultar hóspedes - Fluxo de Sucesso

actor Usuario
participant "Interface Web" as UI
participant "HospedesController" as Controller
participant "HospedesFacade" as Facade
participant "DTO" as DTO
participant "Strategy" as Strategy
entity "Hospede, CPF, Email, Telefone, Endereco, Cidade" as Domain
entity "TypeormHospedeEntity" as PersistEntity
database "TypeormHospedesDao" as Dao

Usuario -> UI: informa filtros de consulta
UI -> Controller: GET /hospedes?filtros
Controller -> Facade: findByParameters(searchParameters)
Facade -> DTO: montar parâmetros de busca
Facade -> Strategy: FIND_BY_PARAMETERS
Strategy -> Dao: findByParameters(searchParameters)
Dao -> PersistEntity: aplicar filtros e paginação
PersistEntity --> Dao: lista de entidades
Dao --> Strategy: EntityPage<Hospede>
Facade -> Strategy: ENTITY_TO_DTO
Strategy --> Facade: EntityPageDto
Facade --> Controller: EntityPageDto
Controller --> UI: 200 OK
UI --> Usuario: exibe listagem filtrada
@enduml
